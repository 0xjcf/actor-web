# Copy this file to .env.local and fill the keys you want to try.
# The examples dev server reads .env.local. These values stay on the server.
# The queue board currently uses OPENAI_API_KEY for the Codex Responses proxy.

# OpenAI / Codex. https://api.openai.com/v1/responses
# The key stays on the dev server. Model overrides are copied into the page as the request model id.
OPENAI_API_KEY=

# Optional. Defaults: planner gpt-6.2-astra, builder and reviewer gpt-6.2-sol.
# Restart the examples server after changing these.
# OPENAI_PLANNER_MODEL=gpt-6.2-astra
# OPENAI_BUILDER_MODEL=gpt-6.2-sol
# OPENAI_REVIEWER_MODEL=gpt-6.2-sol

# DeepSeek. OpenAI-compatible chat completions.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Anthropic Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Ollama. Local OpenAI-compatible endpoint. A key is usually unnecessary.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# xAI Grok. OpenAI-compatible chat completions.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Google Gemini. OpenAI-compatible chat completions.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
