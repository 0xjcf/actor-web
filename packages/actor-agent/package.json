{
  "name": "@actor-web/agent",
  "version": "0.2.2",
  "description": "LLM tool and agent-loop utilities for actor-web runtime hosts",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && tsup && node scripts/write-cjs-types.mjs && node ../../scripts/verify-exports.mjs . && pnpm test:public-entries",
    "test:public-entries": "tsc --noEmit --strict --module node16 --target es2022 tests/consume-portable.mts tests/consume-portable.cts && node tests/verify-portable.mjs && node tests/verify-actor-runtime.mjs",
    "build:watch": "pnpm build --watch",
    "dev": "vitest --watch",
    "test": "vitest run",
    "test:live:openai-compatible": "ACTOR_AGENT_RUN_LIVE_OPENAI_COMPAT=1 vitest run tests/openai-compatible-live.test.ts",
    "lint": "biome check .",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "keywords": [
    "actor-model",
    "agents",
    "llm",
    "runtime"
  ],
  "author": "Actor-Web Team",
  "license": "MIT",
  "dependencies": {
    "@actor-web/runtime": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.4",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xjcf/actor-web.git",
    "directory": "packages/actor-agent"
  },
  "homepage": "https://github.com/0xjcf/actor-web#readme",
  "bugs": {
    "url": "https://github.com/0xjcf/actor-web/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./portable": {
      "import": {
        "types": "./dist/portable.d.ts",
        "default": "./dist/portable.js"
      },
      "require": {
        "types": "./dist/portable.d.cts",
        "default": "./dist/portable.cjs"
      }
    },
    "./actor-runtime": {
      "import": {
        "types": "./dist/actor-runtime.d.ts",
        "default": "./dist/actor-runtime.js"
      },
      "require": {
        "types": "./dist/actor-runtime.d.cts",
        "default": "./dist/actor-runtime.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      },
      "require": {
        "types": "./dist/zod.d.cts",
        "default": "./dist/zod.cjs"
      }
    }
  }
}
