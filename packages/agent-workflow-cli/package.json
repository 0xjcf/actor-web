{
  "name": "@actor-web/cli",
  "version": "0.1.0",
  "private": false,
  "description": "Distributed Actor-Web runtime host CLI with authenticated remote operator shells",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "actor-web": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli/index.ts --format cjs,esm --clean && rm -f tsconfig.tsbuildinfo && tsc -p tsconfig.json --emitDeclarationOnly --declaration --declarationMap false --outDir dist && node ../../scripts/verify-exports.mjs .",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "actor",
    "actor-model",
    "runtime",
    "cli",
    "actor-web"
  ],
  "author": "Actor-Web Team",
  "license": "MIT",
  "dependencies": {
    "@actor-web/agent": "workspace:*",
    "@actor-web/runtime": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xjcf/actor-web.git",
    "directory": "packages/agent-workflow-cli"
  },
  "homepage": "https://github.com/0xjcf/actor-web#readme",
  "bugs": {
    "url": "https://github.com/0xjcf/actor-web/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
